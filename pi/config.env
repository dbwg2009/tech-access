# tech-access Pi settings. Committed on purpose: nothing secret lives here.
# Every pi/*.sh script reads this file. Override any value for one run with an env var,
# e.g. REPO_REF=claude/some-branch sudo -E ./05-bun-hub.sh

# --- Identity (decisions 2026-11-15) ---
PI_HOSTNAME="${PI_HOSTNAME:-tech-hub}"
TIMEZONE="${TIMEZONE:-Europe/London}"

# --- Show network: Control subnet, static, no gateway, no DNS ---
ETH_IFACE="${ETH_IFACE:-eth0}"
STATIC_IP="${STATIC_IP:-10.102.40.10}"
PREFIX="${PREFIX:-16}"
GATEWAY="${GATEWAY:-}"                    # blank = none (the show network has no router yet)
NTP_ALLOW="${NTP_ALLOW:-10.102.0.0/16}"   # who may get time from the Pi (boxes)

# --- Hardware ---
RTC_BATTERY="${RTC_BATTERY:-rechargeable}"  # rechargeable = official Li-Mn cell fitted; none = no charging
RTC_CHARGE_UV="${RTC_CHARGE_UV:-3000000}"   # microvolts, from the Raspberry Pi RTC docs
BOOT_ORDER="${BOOT_ORDER:-0xf416}"          # NVMe, then SD, then USB, then restart

# --- Desk panel (weeks 3-4) ---
READER_DEVICE="${READER_DEVICE:-/dev/ttyAMA0}"   # PN532 on GPIO14/15 (Pi 5 UART0)
KIOSK_USER="${KIOSK_USER:-kiosk}"               # logs in on tty1 and runs the panel
SCREEN_OFF_SECONDS="${SCREEN_OFF_SECONDS:-300}" # decision 2026-11-16: 5 minutes

# --- Services ---
MQTT_PORT="${MQTT_PORT:-1883}"
HUB_PORT="${HUB_PORT:-8080}"

# --- Hub install ---
REPO_URL="${REPO_URL:-https://github.com/dbwg2009/tech-access.git}"
REPO_REF="${REPO_REF:-main}"
INSTALL_DIR="${INSTALL_DIR:-/opt/tech-access}"
BUN_VERSION="${BUN_VERSION:-1.4.4}"
HUB_USER="${HUB_USER:-techaccess}"

# --- Paths on the Pi (not in git) ---
ETC_DIR="${ETC_DIR:-/etc/tech-access}"
DATA_DIR="${DATA_DIR:-/var/lib/tech-access}"
